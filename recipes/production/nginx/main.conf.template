# HTTPS server block of the main domain, rendered at startup with the DOMAIN variable
# jonasal/nginx-certbot requests one certificate per ssl_certificate_key path with the server names of the same file,
# the portals wildcard is kept in a separate file for this reason. http is redirected to https by the image itself.

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${DOMAIN};
  ssl_certificate /etc/letsencrypt/live/main/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/main/privkey.pem;
  ssl_trusted_certificate /etc/letsencrypt/live/main/chain.pem;

  include /etc/nginx/includes/proxy.conf;
  include /etc/nginx/includes/locations.conf;
}
